# ========================================================
# ROOT - ENVIRONMENT TEMPLATE
# Copy to .env.local for local dev, or .env.production for production
# ========================================================

# Service Ports
API_PORT=9000
WEB_PORT=4000
MARTIN_PORT=9090

# Martin Tile Server
MARTIN_URL=http://localhost:9090
MARTIN_LISTEN_ADDRESSES=0.0.0.0:9090

# Database Connection (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=db_melarosa
DB_USERNAME=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/db_melarosa
