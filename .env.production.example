# ========================================================
# ROOT - PRODUCTION ENVIRONMENT TEMPLATE (.env.production)
# ========================================================

# Host interface binding (127.0.0.1 binds ports to local reverse proxy only, avoiding public exposure)
HOST_BIND=127.0.0.1

# Environment mode
APP_ENV=production
APP_DEBUG=false

# Service Ports
API_PORT=9000
WEB_PORT=4000
MARTIN_PORT=9090

# Martin Tile Server
MARTIN_URL=http://localhost:9090
MARTIN_LISTEN_ADDRESSES=0.0.0.0:9090

# Database Connection (Production PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=db_melarosa
DB_USERNAME=postgres
DB_PASSWORD=your_production_password_here
DATABASE_URL=postgresql://postgres:your_production_password_here@127.0.0.1:5432/db_melarosa
