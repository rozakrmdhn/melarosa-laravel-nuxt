# ========================================================
# NUXT UI - ENVIRONMENT TEMPLATE
# Copy to .env.local for local dev, or .env.production for production
# ========================================================

# Service Port (Nuxt UI: default 4000)
PORT=4000
NUXT_PORT=4000
NITRO_PORT=4000
NUXT_HOST=0.0.0.0
HOST=0.0.0.0

# Laravel API Backend URL (Port 9000)
APP_URL=http://localhost:9000
API_LOCAL_URL=http://localhost:9000

# Martin Tile Server URL (Port 9090)
MARTIN_URL=http://127.0.0.1:9090
NUXT_PUBLIC_MARTIN_URL=/martin
