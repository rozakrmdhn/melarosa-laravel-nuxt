# ========================================================
# NUXT UI - PRODUCTION ENVIRONMENT TEMPLATE (.env.production)
# ========================================================

# Service Port (Nuxt UI: Port 4000)
PORT=4000
NUXT_PORT=4000
NITRO_PORT=4000
NUXT_HOST=0.0.0.0
HOST=0.0.0.0

# Laravel API Backend URL (Production Server URL / Domain)
APP_URL=https://your-api-domain.com
API_LOCAL_URL=http://laravelnuxt.api:9000

# Martin Tile Server URL (Port 9090 / Production URL)
MARTIN_URL=http://martin:9090
NUXT_PUBLIC_MARTIN_URL=/martin
